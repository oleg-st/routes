{
  "name": "fellowship-route-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "data": "node scripts/prepare-data.mjs",
    "data:game": "node scripts/prepare-data.mjs",
    "data:summons": "node scripts/prepare-game-summons.mjs",
    "replay:logs": "node scripts/replay-log-summons.mjs",
    "images": "node scripts/prepare-images.mjs",
    "maps": "node scripts/prepare-combined-maps.mjs",
    "build:local": "node scripts/build-local.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/update-route-mapping.mjs --check && node --check app.js && node --check route-model.js && node scripts/verify-data.mjs && node scripts/build-local.mjs --check",
    "test:crdt": "node --test tests/route-crdt.test.mjs",
    "test:health:browser": "node tests/difficulty-health-ui.mjs",
    "test:crdt:browser": "node tests/route-crdt-browser.mjs",
    "test:storage:browser": "node tests/route-storage-browser.mjs",
    "test:editor": "node tests/route-ui.mjs && node tests/drawing-ui.mjs && node tests/pull-split-ui.mjs && node tests/transfer-ui.mjs && node tests/route-together-ui.mjs",
    "test:keyboard": "node tests/keyboard-ui.mjs",
    "test:site:browser": "node tests/route-site-browser.mjs",
    "test:site:cache": "node tests/site-cache-browser.mjs",
    "test:rooms": "node --test tests/room-manager.test.mjs",
    "test:rooms:browser": "node tests/room-browser.mjs",
    "test:cursors:browser": "node tests/cursor-transport-browser.mjs",
    "test:network:browser": "node tests/network-check-browser.mjs",
    "data:mapping": "node scripts/update-route-mapping.mjs",
    "patch:baseline": "node scripts/game-patch.mjs baseline",
    "patch:plan": "node scripts/game-patch.mjs plan",
    "patch:extract": "node scripts/game-patch.mjs extract",
    "patch:report": "node scripts/game-patch.mjs report",
    "patch:build": "node scripts/game-patch.mjs build",
    "maps:editor": "node scripts/map-editor-server.mjs",
    "test:maps:editor": "node tests/map-editor-browser.mjs"
  },
  "dependencies": {
    "@trystero-p2p/core": "0.26.0",
    "loro-crdt": "1.16.4",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
